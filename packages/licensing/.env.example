# GRAFT licensing backend — environment template.
# Copy to `.env` (which is gitignored) and fill in from your Stripe account.
# NEVER commit the real .env. These are server-only secrets; the desktop app never sees them.

# Stripe secret key. Use a TEST key (sk_test_...) during development.
# A live key (sk_live_...) switches the service to live mode and causes real charges.
STRIPE_SECRET_KEY=sk_test_replace_me

# Webhook signing secret for your endpoint (whsec_...). From the Stripe webhook you create,
# or from `stripe listen` when forwarding locally.
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# The Price id (price_...) for the single $49 one-time GRAFT product.
# If you do not have one yet, the setup script can create the product and price for you.
STRIPE_PRICE_ID=price_replace_me

# Public base URL where this service is reachable (used to build Checkout return URLs
# and must match the webhook you register). For local Stripe CLI forwarding this is
# typically http://127.0.0.1:8787.
GRAFT_PUBLIC_URL=http://127.0.0.1:8787

# Where the download entitlement redirects a valid, activated license.
# Point this at the signed/notarized GRAFT.app installer once it exists.
GRAFT_DOWNLOAD_URL=https://example.invalid/download/GRAFT.dmg

# Stripe Managed Payments requires an eligible tax code on the GRAFT Product (name + price
# alone is not sufficient). GRAFT is prewritten, downloadable desktop software sold as a
# one-time license. Default (owner decision): txcd_10202003, Downloadable Software - business
# use. Override only with another eligible downloadable-software code:
#   txcd_10202001  Downloadable Software - non-recreational - personal use   (individual buyers)
#   txcd_10202003  Downloadable Software - business use                       (commercial enterprises)
#   txcd_10202000  Downloadable Software - personal use                       (generic personal)
#   txcd_10000000  General - Electronically Supplied Services                 (generic fallback)
# The personal/business distinction only affects US sales. This is a tax decision — pick deliberately.
GRAFT_TAX_CODE=txcd_10202003

# Optional. Product identity triple the desktop client checks; must match
# packages/desktop/config/product.json. Defaults: 1 / 1 / 1.
# GRAFT_STORE_ID=1
# GRAFT_PRODUCT_ID=1
# GRAFT_VARIANT_ID=1

# Optional. Activation seats per license (default 3) and listen port (default 8787).
# The launch price is fixed at $49.00 and is not configurable.
# GRAFT_MAX_ACTIVATIONS=3
# PORT=8787
